# Copy to .env.local for development. All values are PUBLIC (they ship in the browser bundle).
# Access control is enforced by Postgres Row-Level Security, not by hiding these.

VITE_APP_NAME="Study Split"
# Path the site is served from. GitHub Pages project site: /study-split-app/  ·  custom domain: /
VITE_BASE_PATH=/study-split-app/

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Google Cloud → Google Auth Platform → Clients → Web client ID
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
